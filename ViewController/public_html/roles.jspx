<?xml version='1.0' encoding='windows-1252'?>
<jsp:root 
    xmlns:jsp="http://java.sun.com/JSP/Page" 
    version="2.1"
    xmlns:f="http://java.sun.com/jsf/core"
    xmlns:h="http://java.sun.com/jsf/html"
    xmlns:c="http://java.sun.com/jsp/jstl/core">
  <jsp:output omit-xml-declaration="true"
              doctype-root-element="html"
              doctype-public="-//W3C//DTD HTML 4.01 Transitional//EN"
              doctype-system="http://www.w3.org/TR/html4/loose.dtd"/>
  <jsp:directive.page contentType="text/html;charset=windows-1252"/>
  <f:view>
    <html>
      <head>
        <title>Manage Roles</title>
        <style>
          table { border-collapse: collapse; width: 80%; margin: 20px auto; }
          th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
          th { background-color: #4CAF50; color: white; }
          .btn { padding: 5px 10px; margin-right: 5px; cursor: pointer; }
          .btn-update { background-color: #2196F3; color: white; border: none; }
          .btn-delete { background-color: #f44336; color: white; border: none; }
          .btn-dashboard { background-color: #FFC107; color: #212529; border: none; }
          .message { width: 80%; margin: 10px auto; text-align: center; font-weight: bold; }
          .success { color: green; }
          .error { color: red; }
        </style>
      </head>
      <body>
        <h1 style="text-align:center;">Role Management</h1>

        <h:form id="roleForm">
          <h:messages globalOnly="true" styleClass="error" />

          <table>
            <thead>
              <tr>
                <th>Role Name</th>
                <th>Role Description</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <c:forEach items="#{updateDeleteBeans.roleList}" var="role">
                <tr>
                  <td>
                    <h:outputText value="#{role.rolename}" rendered="#{updateDeleteBeans.selectedRole != role}" />
                    <h:inputText value="#{updateDeleteBeans.selectedRole.rolename}" rendered="#{updateDeleteBeans.selectedRole == role}" disabled="true" />
                  </td>
                  <td>
                    <h:outputText value="#{role.roleDesc}" rendered="#{updateDeleteBeans.selectedRole != role}" />
                    <h:inputText value="#{updateDeleteBeans.selectedRole.roleDesc}" rendered="#{updateDeleteBeans.selectedRole == role}" />
                  </td>
                  <td>
                    <h:commandButton value="Edit" action="#{updateDeleteBeans.prepareEdit}" rendered="#{updateDeleteBeans.selectedRole != role}" styleClass="btn btn-update">
                      <f:setPropertyActionListener target="#{updateDeleteBeans.selectedRole}" value="#{role}" />
                    </h:commandButton>

                    <h:commandButton value="Delete" action="#{updateDeleteBeans.deleteRole}" rendered="#{updateDeleteBeans.selectedRole != role}" styleClass="btn btn-delete"
                                     onclick="return confirm('Are you sure you want to delete this role?');">
                      <f:setPropertyActionListener target="#{updateDeleteBeans.selectedRole}" value="#{role}" />
                    </h:commandButton>

                    <h:commandButton value="Update" action="#{updateDeleteBeans.updateRole}" rendered="#{updateDeleteBeans.selectedRole == role}" styleClass="btn btn-update" />
                    <h:commandButton value="Cancel" action="#{updateDeleteBeans.cancelEdit}" rendered="#{updateDeleteBeans.selectedRole == role}" styleClass="btn" />
                  </td>
                </tr>
              </c:forEach>
            </tbody>
          </table>

          <div class="message #{updateDeleteBeans.messageClass}">
            <h:outputText value="#{updateDeleteBeans.message}" />
          </div>

          <!-- Add the Go to Dashboard button here: -->
          <div style="text-align: center; margin-top: 20px;">
            <h:commandButton value="Go to Dashboard" action="dashboard" styleClass="btn btn-dashboard" immediate="true"/>
          </div>
        </h:form>
      </body>
    </html>
  </f:view>
</jsp:root>
