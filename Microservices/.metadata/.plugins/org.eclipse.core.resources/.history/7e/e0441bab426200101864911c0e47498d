package cps.services.impl;

import java.util.Map;

import org.bson.types.ObjectId;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.ReactiveMongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.data.mongodb.core.query.Update;
import org.springframework.stereotype.Service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.mongodb.client.result.UpdateResult;

import cps.entities.CustomerClaimsQueriesEO;
import cps.services.CustomerClaimsQueriesServices;
import reactor.core.publisher.Mono;


@Service
public class CustomerClaimsQueriesServicesImpl implements CustomerClaimsQueriesServices {
	
	@Autowired
	private ReactiveMongoTemplate reactiveMongoTemplate;
	

	@Override
	public Mono<CustomerClaimsQueriesEO> addNewQuery(CustomerClaimsQueriesEO customerClaimsQueriesEO) {
	    return reactiveMongoTemplate.save(customerClaimsQueriesEO);
	}
	
	@Override
	public Mono<CustomerClaimsQueriesEO> getQueryByClaimId(String customerClaimid) {
		Query query = new Query(Criteria.where("customerClaimid").is(customerClaimid));
	    return reactiveMongoTemplate.save(customerClaimsQueriesEO);
	}


	@Override
	public Mono<UpdateResult> updateQuery(ObjectId id, CustomerClaimsQueriesEO customerClaimsQueriesEO) {
		Query query = new Query(Criteria.where("_id").is(id));
		Update update = new Update();

		@SuppressWarnings("unchecked")
		Map<String, Object> map = new ObjectMapper().convertValue(customerClaimsQueriesEO, Map.class);
		map.forEach((key, value) -> {
			if (value != null && !key.equals("_id")) {
				update.set(key, value);
			}
		});

		Mono<UpdateResult> result = reactiveMongoTemplate.update(CustomerClaimsQueriesEO.class).matching(query).apply(update)
				.upsert();

		return result;
	}

}
