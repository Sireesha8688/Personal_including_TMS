@RestController
@RequestMapping("/api/admin")
@CrossOrigin(origins = "http://localhost:5173")

public class AdminController {

	@Autowired
	private AdminService adminService;

	@Autowired
	private CoverService coverServiceRef;

	@Autowired
	private ClaimTypesService claimTypesServiceRef;

	@Autowired
	private InsurerService insurerServiceRef;

	@Autowired
	private PolicyService policyServiceRef;

	@Autowired
