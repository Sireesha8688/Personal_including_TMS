	@GetMapping("/getAllAdmins")
	public List<AdminsEO> getAllAdmins() {
		return adminService.getAllAdmins();
	}

	@PostMapping("/addAdmin")
	public ResponseEntity<AdminsEO> addAdmin(@RequestBody AdminsEO admin) {
		AdminsEO created = adminService.addAdmin(admin);
		return new ResponseEntity<>(created, HttpStatus.CREATED);
	}

	@PutMapping("/updateAdmin/{id}")
	public ResponseEntity<?> updateAdmin(@PathVariable String id, @RequestBody AdminsEO admin) {
		try {
			ObjectId objectId = new ObjectId(id);
			AdminsEO updated = adminService.updateAdmin(objectId, admin);
			if (updated != null) {
				return ResponseEntity.ok(updated);
			} else {
				return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Admin not found");
			}
		} catch (IllegalArgumentException e) {
			return ResponseEntity.badRequest().body("Invalid ObjectId format");
		}
	}

	@DeleteMapping("/deleteAdmin/{id}")
	public ResponseEntity<?> deleteAdmin(@PathVariable String id) {
		try {
			ObjectId objectId = new ObjectId(id);
			adminService.deleteAdmin(objectId);
			return ResponseEntity.ok("Deleted successfully");
		} catch (IllegalArgumentException e) {
			return ResponseEntity.badRequest().body("Invalid ObjectId format");
		}
	}

